<Window x:Class="InvestmentPortfolio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Investment Portfolio" Height="720" Width="1180" WindowStartupLocation="CenterScreen">
<Grid Margin="16">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="Portfolio" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/><Button Content="Dodaj inwestycję" Click="Add_Click" Margin="24,0,0,0" Padding="16,8"/><Button Content="Usuń zaznaczoną" Click="Delete_Click" Margin="8,0,0,0" Padding="16,8"/></StackPanel>
<Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="1" Padding="12" Margin="0,0,6,0"><StackPanel><TextBlock Text="Wartość bieżąca"/><TextBlock x:Name="TotalCurrentText" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
<Border Grid.Column="1" BorderBrush="#DDD" BorderThickness="1" Padding="12" Margin="6,0"><StackPanel><TextBlock Text="Zainwestowano"/><TextBlock x:Name="TotalInvestedText" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
<Border Grid.Column="2" BorderBrush="#DDD" BorderThickness="1" Padding="12" Margin="6,0"><StackPanel><TextBlock Text="Wynik"/><TextBlock x:Name="TotalProfitText" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
<Border Grid.Column="3" BorderBrush="#DDD" BorderThickness="1" Padding="12" Margin="6,0,0,0"><StackPanel><TextBlock Text="Pozycje"/><TextBlock x:Name="CountText" FontSize="20" FontWeight="Bold"/></StackPanel></Border></Grid>
<TabControl Grid.Row="2">
<TabItem Header="Inwestycje"><DataGrid x:Name="InvestmentsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Margin="0,8" MouseDoubleClick="Edit_DoubleClick">
<DataGrid.Columns><DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Ticker" Binding="{Binding Ticker}"/><DataGridTextColumn Header="Typ" Binding="{Binding Type}"/><DataGridTextColumn Header="Waluta" Binding="{Binding Currency}"/><DataGridTextColumn Header="Ilość" Binding="{Binding Quantity, StringFormat=N4}"/><DataGridTextColumn Header="Zakup" Binding="{Binding PurchasePrice, StringFormat=N2}"/><DataGridTextColumn Header="Bieżąca" Binding="{Binding CurrentPrice, StringFormat=N2}"/><DataGridTextColumn Header="Wartość" Binding="{Binding CurrentValue, StringFormat=N2}"/><DataGridTextColumn Header="Wynik" Binding="{Binding ProfitLoss, StringFormat=N2}"/><DataGridTextColumn Header="Wynik %" Binding="{Binding ProfitLossPercent, StringFormat=N2}"/></DataGrid.Columns>
</DataGrid></TabItem>
<TabItem Header="Podsumowanie wg typu"><DataGrid x:Name="SummaryGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8"><DataGrid.Columns><DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="2*"/><DataGridTextColumn Header="Pozycje" Binding="{Binding Count}"/><DataGridTextColumn Header="Zainwestowano" Binding="{Binding Invested, StringFormat=N2}"/><DataGridTextColumn Header="Wartość" Binding="{Binding Current, StringFormat=N2}"/><DataGridTextColumn Header="Wynik" Binding="{Binding Profit, StringFormat=N2}"/><DataGridTextColumn Header="Wynik %" Binding="{Binding ProfitPercent, StringFormat=N2}"/></DataGrid.Columns></DataGrid></TabItem>
<TabItem Header="Podsumowanie wg waluty"><DataGrid x:Name="CurrencyGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8"><DataGrid.Columns><DataGridTextColumn Header="Waluta" Binding="{Binding Currency}" Width="2*"/><DataGridTextColumn Header="Pozycje" Binding="{Binding Count}"/><DataGridTextColumn Header="Zainwestowano" Binding="{Binding Invested, StringFormat=N2}"/><DataGridTextColumn Header="Wartość" Binding="{Binding Current, StringFormat=N2}"/><DataGridTextColumn Header="Wynik" Binding="{Binding Profit, StringFormat=N2}"/></DataGrid.Columns></DataGrid></TabItem>
</TabControl></Grid></Window>