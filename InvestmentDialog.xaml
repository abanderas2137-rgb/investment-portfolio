<Window x:Class="InvestmentPortfolio.InvestmentDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Inwestycja" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner">
<Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
<TextBlock Text="Nazwa" Margin="0,6"/><TextBox x:Name="NameBox" Grid.Column="1" Margin="0,4"/><TextBlock Text="Ticker / symbol" Grid.Row="1" Margin="0,6"/><TextBox x:Name="TickerBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/><TextBlock Text="Typ" Grid.Row="2" Margin="0,6"/><ComboBox x:Name="TypeBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/><TextBlock Text="Waluta" Grid.Row="3" Margin="0,6"/><ComboBox x:Name="CurrencyBox" Grid.Row="3" Grid.Column="1" Margin="0,4"/><TextBlock Text="Ilość" Grid.Row="4" Margin="0,6"/><TextBox x:Name="QuantityBox" Grid.Row="4" Grid.Column="1" Margin="0,4"/><TextBlock Text="Cena zakupu" Grid.Row="5" Margin="0,6"/><TextBox x:Name="PurchaseBox" Grid.Row="5" Grid.Column="1" Margin="0,4"/><TextBlock Text="Aktualna cena" Grid.Row="6" Margin="0,6"/><TextBlock Grid.Row="6" Grid.Column="1" Text="Pobierana automatycznie z internetu dla akcji, obligacji i ETF." TextWrapping="Wrap" VerticalAlignment="Center"/><TextBlock Text="Data zakupu" Grid.Row="7" Margin="0,6"/><DatePicker x:Name="DateBox" Grid.Row="7" Grid.Column="1" Margin="0,4"/>
<StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Anuluj" Click="Cancel_Click" Padding="18,7" Margin="0,0,8,0"/><Button Content="Zapisz" Click="Save_Click" Padding="18,7"/></StackPanel></Grid></Window>